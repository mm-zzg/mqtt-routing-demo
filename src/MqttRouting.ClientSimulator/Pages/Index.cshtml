@page
@model IndexModel
@{
    ViewData["Title"] = "MQTT Client Simulator";
}

<h1 class="display-6 mb-3">MQTT Client Simulator</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Add Client Certificate</div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddCertificate">
                    <div class="mb-3">
                        <label asp-for="NewCertificate.Name" class="form-label"></label>
                        <input asp-for="NewCertificate.Name" class="form-control" />
                        <span asp-validation-for="NewCertificate.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCertificate.PfxBase64" class="form-label">PFX Base64</label>
                        <textarea asp-for="NewCertificate.PfxBase64" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="NewCertificate.PfxBase64" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCertificate.Password" class="form-label"></label>
                        <input asp-for="NewCertificate.Password" type="password" class="form-control" />
                        <span asp-validation-for="NewCertificate.Password" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary" type="submit">Save certificate</button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Certificates</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var certificate in Model.Certificates)
                    {
                        <tr>
                            <td>@certificate.Name</td>
                            <td>@certificate.CreatedAt.ToLocalTime().ToString("u")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Create Simulated Client</div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddClient">
                    <div class="mb-3">
                        <label asp-for="NewClient.Name" class="form-label"></label>
                        <input asp-for="NewClient.Name" class="form-control" />
                        <span asp-validation-for="NewClient.Name" class="text-danger"></span>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="NewClient.BrokerHost" class="form-label"></label>
                            <input asp-for="NewClient.BrokerHost" class="form-control" />
                            <span asp-validation-for="NewClient.BrokerHost" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label asp-for="NewClient.BrokerPort" class="form-label"></label>
                            <input asp-for="NewClient.BrokerPort" class="form-control" />
                            <span asp-validation-for="NewClient.BrokerPort" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 mt-2">
                        <label asp-for="NewClient.Topic" class="form-label"></label>
                        <input asp-for="NewClient.Topic" class="form-control" />
                        <span asp-validation-for="NewClient.Topic" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewClient.PublishIntervalSeconds" class="form-label"></label>
                        <input asp-for="NewClient.PublishIntervalSeconds" class="form-control" />
                        <span asp-validation-for="NewClient.PublishIntervalSeconds" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewClient.CertificateId" class="form-label">Certificate</label>
                        <select asp-for="NewClient.CertificateId" class="form-select">
                            <option value="">None</option>
                            @foreach (var certificate in Model.Certificates)
                            {
                                <option value="@certificate.Id">@certificate.Name</option>
                            }
                        </select>
                        <span asp-validation-for="NewClient.CertificateId" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary" type="submit">Create client</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">Ongoing Clients</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Broker</th>
                    <th>Topic</th>
                    <th>Status</th>
                    <th>Publishes</th>
                    <th>Last Activity</th>
                    <th>Error</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var client in Model.Clients)
            {
                <tr>
                    <td>@client.Name</td>
                    <td>@client.BrokerHost:@client.BrokerPort</td>
                    <td>@client.Topic</td>
                    <td>@client.Status</td>
                    <td>@client.PublishCount</td>
                    <td>@(client.LastPublishedAt?.ToLocalTime().ToString("u") ?? "-")</td>
                    <td>@(client.LastError ?? "-")</td>
                    <td class="d-flex gap-1">
                        <form method="post" asp-page-handler="StartClient">
                            <input type="hidden" name="clientId" value="@client.Id" />
                            <button class="btn btn-sm btn-success" type="submit">Start</button>
                        </form>
                        <form method="post" asp-page-handler="StopClient">
                            <input type="hidden" name="clientId" value="@client.Id" />
                            <button class="btn btn-sm btn-warning" type="submit">Stop</button>
                        </form>
                        <form method="post" asp-page-handler="RemoveClient">
                            <input type="hidden" name="clientId" value="@client.Id" />
                            <button class="btn btn-sm btn-danger" type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
